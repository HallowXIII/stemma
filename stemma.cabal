cabal-version:      3.0
name:               stemma
version:            0.1.0
synopsis:           Computed etymological lexicons for conlang families
license:            BSD-3-Clause
build-type:         Simple
extra-source-files:
  typst/stemma.typ
  ui/index.html

common shared
  default-language: GHC2021
  default-extensions:
    LambdaCase
    OverloadedStrings
    RecordWildCards
  ghc-options:      -Wall
  build-depends:
      base >=4.18 && <5
    , containers
    , text

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    Stemma.Types
    Stemma.Load
    Stemma.Engine
    Stemma.Engine.Brassica
    Stemma.Build
    Stemma.Collate
    Stemma.Notes
    Stemma.Output
    Stemma.Query
    Stemma.Sources
    Stemma.Typst
    Stemma.View
  other-modules:
    Paths_stemma
  autogen-modules:
    Paths_stemma
  build-depends:
      aeson >=2.1
    , aeson-pretty
    , brassica ==1.0.*
    , bytestring
    , directory
    , file-embed
    , filepath
    , yaml

executable stemma
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
      stemma
    , bytestring
    , directory
    , optparse-applicative
    , filepath

executable stemma-server
  import:           shared
  hs-source-dirs:   server
  main-is:          Main.hs
  other-modules:
    Server.Api
    Server.Files
    Server.StageRules
  build-depends:
      stemma
    , aeson
    , bytestring
    , directory
    , file-embed
    , filepath
    , http-types
    , optparse-applicative
    , scientific
    , time
    , wai
    , warp

test-suite example
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test server
  main-is:          Example.hs
  other-modules:
    Server.StageRules
  build-depends:
      stemma
    , bytestring
    , directory
    , filepath
    , temporary
