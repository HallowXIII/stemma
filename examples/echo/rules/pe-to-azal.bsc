; STUB: only the changes needed by the demonstrative example, taken from
; historical-notes.md and the Azal grammar. Not the real sound laws.

categories
C = p t k b d g m n l r₁ r₂ r s š h x ɣ v y w
V = a e i o u ā ē ī ō ū
end

; --- Proto-Echo > Old Azal ---
x / h
ɣ / h
w / v
; dative *-xx on consonant stems
h h / ā / C _ #

report

; --- Old Azal > Azal ---
; *r₁: /l/ before (non-glide) consonants and word-finally, /r/ elsewhere
r₁ / l / _ [C -y -v]
r₁ / l / _ #
r₁ / r
; *r₂: [ɕ] ⟨š⟩ word-finally, /r/ elsewhere
r₂ / š / _ #
r₂ / r
; epenthesis into word-final clusters
/ e / C _ C #
